# Copy to .env (gitignored). Wrangler reads .env for `npm run dev`
# and `npx wrangler secret bulk .env` uploads it for production.

# Telegram (BotFather token; WEBHOOK_SECRET is any random string, reuse it in setWebhook's secret_token)
BOT_TOKEN=
WEBHOOK_SECRET=
BOT_NAME=Pengy

# Gemini via its OpenAI-compatible endpoint (see GEMINI_SETUP.md)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_DEFAULT_RESPONSE=Pengy bị lag rồi, thử lại sau nha
OPENAI_DEFAULT_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.8
OPENAI_TOP_P=1
# Optional: cap Gemini thinking time (e.g. none / low) if replies are slow
# OPENAI_REASONING_EFFORT=
# Leave penalties unset for Gemini
# OPENAI_PRESENCE_PENALTY=
# OPENAI_FREQUENCY_PENALTY=

# Firebase web app config (Firebase console > Project settings > Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

WEB_SEARCH_API_KEY=