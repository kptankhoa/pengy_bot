{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pengy-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["0 2,8 * * *", "* * * * *"] },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "vars": {
    "BLOCKED_USER_IDS": "8679896727",
    "BANNED_MESSAGE": "Bạn đã khóa mõm Sang Nguyen 5p",
    "BAN_COMMAND_USER_IDS": "8679896727",
  },
}
